@{
    ViewBag.Title = "Početna";
    var username = (string)Session["Username"];
    bool isLogged = !string.IsNullOrEmpty(username);
}

<div class="py-4">
    <div class="p-4 p-md-5 rounded-4 shadow-sm border bg-white">
        <div class="row align-items-center g-4">
            <div class="col-md-7">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <span class="badge bg-dark-subtle text-dark px-3 py-2 rounded-pill">Sveznalica</span>
                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Online kviz</span>
                </div>

                <h1 class="display-5 fw-bold mb-2">
                    Testiraj znanje. Osvoji bodove. <span class="text-success">Budi prvi.</span>
                </h1>

                <p class="lead text-muted mb-4">
                    Kviz aplikacija za brza nadmetanja u kategorijama, s rang listom i praćenjem vlastitih rezultata.
                </p>

                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-success btn-lg px-4" href="@Url.Action("Index","Play")">
                        <i class="fa-solid fa-play me-2"></i> Igraj kviz
                    </a>
                    <a class="btn btn-outline-dark btn-lg px-4" href="@Url.Action("Index","Leaderboard")">
                        <i class="fa-solid fa-trophy me-2"></i> Rang lista
                    </a>
                    @if (isLogged)
                    {
                        <a class="btn btn-outline-primary btn-lg px-4" href="@Url.Action("My","Results")">
                            <i class="fa-solid fa-chart-line me-2"></i> Moji rezultati
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-lg px-4" href="@Url.Action("Login","Auth")">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> Prijavi se
                        </a>
                    }
                </div>

                @if (isLogged)
                {
                    <div class="mt-3 text-muted">
                        <i class="fa-solid fa-user me-1"></i>
                        Prijavljen kao <strong>@username</strong>
                    </div>
                }
            </div>

            <div class="col-md-5">
                <div class="rounded-4 border p-4 bg-light">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="fw-semibold">Brzi pregled</div>
                        <span class="badge bg-success">Spremno</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 rounded-4 bg-white border h-100">
                                <div class="text-muted small mb-1">Rang lista</div>
                                <div class="fw-bold">Top rezultati</div>
                                <div class="text-muted small">po kvizu</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-4 bg-white border h-100">
                                <div class="text-muted small mb-1">Rezultati</div>
                                <div class="fw-bold">Moje igre</div>
                                <div class="text-muted small">zadnje / povijest</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-4 bg-white border h-100">
                                <div class="text-muted small mb-1">Kategorije</div>
                                <div class="fw-bold">Razne teme</div>
                                <div class="text-muted small">opće, film, glazba…</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-4 bg-white border h-100">
                                <div class="text-muted small mb-1">Profil</div>
                                <div class="fw-bold">Avatar</div>
                                <div class="text-muted small">personalizacija</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 small text-muted">
                        <i class="fa-solid fa-database me-1"></i> Dobrodosli! 
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-4">
        <div class="col-md-4">
            <div class="p-4 rounded-4 border bg-white h-100">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fa-solid fa-layer-group text-primary"></i>
                    <div class="fw-semibold">Kategorije</div>
                </div>
                <div class="text-muted">
                    Više tematskih kategorija za različite interese.
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 rounded-4 border bg-white h-100">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fa-solid fa-circle-question text-danger"></i>
                    <div class="fw-semibold">Pitanja</div>
                </div>
                <div class="text-muted">
                    Svako pitanje ima 4 ponuđena odgovora i bodove.
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 rounded-4 border bg-white h-100">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fa-solid fa-trophy text-warning"></i>
                    <div class="fw-semibold">Rang lista</div>
                </div>
                <div class="text-muted">
                    Najbolji rezultati po kvizu, sortirani po bodovima.
                </div>
            </div>
        </div>
    </div>
</div>
