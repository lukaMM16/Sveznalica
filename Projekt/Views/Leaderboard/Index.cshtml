
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

@model List<Quiz>

<h2>Rang liste</h2>

<ul class="list-group">
    @foreach (var q in Model)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>@q.Title</span>
            @Html.ActionLink("Pogledaj", "Quiz", new { id = q.Id }, new { @class = "btn btn-sm btn-primary" })
        </li>
    }
</ul>
