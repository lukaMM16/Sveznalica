
@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@model Quiz
@Html.HiddenFor(m => m.Id)

<h2>Novi kviz</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Title)
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.Label("Kategorija")
        @Html.DropDownList("CategoryId", (SelectList)ViewBag.CategoryId, "-- odaberi --", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Difficulty, "Težina (1-3)")
        @Html.TextBoxFor(m => m.Difficulty, new { @class = "form-control", type = "number", min = "1", max = "3" })
        @Html.ValidationMessageFor(m => m.Difficulty, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.TimeLimitSec, "Time limit (sek)")
        @Html.TextBoxFor(m => m.TimeLimitSec, new { @class = "form-control", type = "number", min = "10" })
        @Html.ValidationMessageFor(m => m.TimeLimitSec, "", new { @class = "text-danger" })
    </div>

    <button class="btn btn-success" type="submit">Spremi</button>
    @Html.ActionLink("Natrag", "Index", null, new { @class = "btn btn-secondary" })
}
