@{
    ViewBag.Title = "Novi tim";
}

<h2>Novi tim</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        <label>Ime tima</label>
        <input type="text" name="name" class="form-control" />
    </div>

    <br />

    <div class="form-group">
        <label>Članovi tima</label>
        @Html.ListBox("memberIds", (MultiSelectList)ViewBag.Users, new { @class = "form-control", size = "8" })
        <small class="text-muted">Drži Ctrl za odabir više korisnika.</small>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Spremi tim</button>
    @Html.ActionLink("Odustani", "Index", null, new { @class = "btn btn-secondary" })
}