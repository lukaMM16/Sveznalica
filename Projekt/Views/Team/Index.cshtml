@model List<Team>

@{
    ViewBag.Title = "Moji timovi";
}

<h2>Moji timovi</h2>

<p>
    @Html.ActionLink("Novi tim", "Create", null, new { @class = "btn btn-primary" })
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Još nemaš nijedan tim.</div>
}
else
{
    <table class="table table-striped">
        <tr>
            <th>Naziv</th>
            <th>Vlasnik</th>
            <th>Kreirano</th>
            <th></th>
        </tr>

        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.OwnerUsername</td>
                <td>@t.CreatedAt</td>
                <td>
                    @Html.ActionLink("Detalji", "Details", new { id = t.Id }, new { @class = "btn btn-sm btn-info" })
                </td>
            </tr>
        }
    </table>
}